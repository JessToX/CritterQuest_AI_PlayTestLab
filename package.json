{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host localhost --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --local --ip 127.0.0.1 --config dist/server/wrangler.json",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node --experimental-strip-types scripts/check-architecture.ts",
    "check": "npm run architecture:check && npm test && npm run typecheck && npm run lint && npm run format:check && npm run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "local": "npm run db:local && npm run dev"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "^7.30.1",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261120.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "oxfmt@0.61.0": {
      "tinypool": "2.1.2"
    },
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "satori@0.33.5": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
